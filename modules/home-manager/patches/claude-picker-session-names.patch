diff --git a/scripts/helpers.sh b/scripts/helpers.sh
index e1a3fe6..604e1e5 100755
--- a/scripts/helpers.sh
+++ b/scripts/helpers.sh
@@ -73,3 +73,31 @@ copy_to_clipboard() {
   done
   tmux set-buffer -w -- "$1" 2>/dev/null
 }
+
+# claude_session_names
+# Emit `N \t <pid> \t <name> \t <name-source>` for every Claude session that has
+# a name, as a pre-tagged stream for agents.sh's awk.
+#
+# Every live session maintains its own $CLAUDE_CONFIG_DIR/sessions/<pid>.json,
+# which carries the name shown in that session's UI: the one you set with
+# /rename (nameSource "user"), otherwise one Claude derived from the cwd or
+# generated for itself. Taken from those files rather than from the picker's
+# own `claude agents --json`, so the column is populated regardless of which
+# fields that command chooses to expose for an interactive session.
+#
+# Keyed by pid, which is already the join key for a picker row, so a stale file
+# left behind by a dead session simply never matches one. Like the transcript
+# path this is an internal Claude Code detail and may move; jq failing (no
+# sessions dir, or an unreadable/half-written file) just leaves the column '-'.
+#
+# nameSource is absent on sessions started by older Claude versions; it is
+# reported as "unknown" rather than dropped, so such a row still shows a name.
+claude_session_names() {
+  local base
+  base="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
+  jq -r -s '
+    .[]
+    | select(type == "object" and (.pid | type) == "number" and (.name // "") != "")
+    | "N\t\(.pid)\t\(.name)\t\(.nameSource // "unknown")"
+  ' "$base"/sessions/*.json 2>/dev/null
+}
