-#   Row: rank \t pane_id \t pid \t kind \t icon \t age \t loc \t path
+#   Row: rank \t pane_id \t pid \t kind \t icon \t age \t loc \t name \t path
 #   rank/pane_id/pid/kind are hidden from the display via fzf's --with-nth.
 set -uo pipefail
 DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
@@ -27,18 +27,25 @@
   printf 'M\t%s\t%s\n' "$sid" "$(claude_transcript_mtime "$sid")"
 done)"
 
-# Three tagged streams into one awk: pid->tty, tty->pane, session->last-activity.
-# Total cost is 3 subprocesses regardless of how many sessions or panes exist.
+# Four tagged streams into one awk: pid->tty, tty->pane, session->last-activity,
+# pid->name. Total cost is 4 subprocesses regardless of how many sessions or
+# panes exist.
 {
   ps -Ao pid=,tty= 2>/dev/null | awk '{ print "P\t" $1 "\t" $2 }'
   tmux list-panes -a -F $'T\t#{pane_tty}\t#{pane_id}\t#{session_name}\t#{session_name}:#{window_index}.#{pane_index}' 2>/dev/null
   printf '%s\n' "$mtimes"
+  claude_session_names
   printf '%s\n' "$rows" | sed $'s/^/A\t/'
 } | awk -F'\t' -v now="$(date +%s)" -v home="$HOME" \
+  -v namew="$(get_tmux_option @claude_name_width 36)" \
   -v prefix="$(get_tmux_option @claude_session_prefix 'claude-')" '
+  # int() so a garbled @claude_name_width degrades to 0 (an unpadded column)
+  # rather than being spliced into a printf format as a bare string.
+  BEGIN { namew = int(namew) }
   $1 == "P" { tty_of[$2] = $3; next }
   $1 == "T" { sub(/^\/dev\//, "", $2); pane[$2] = $3; sess[$2] = $4; loc[$2] = $5; next }
   $1 == "M" { seen_at[$2] = $3; next }
+  $1 == "N" { name[$2] = $3; name_src[$2] = $4; next }
   $1 == "A" {
     tty = tty_of[$2]
     if (tty == "" || !(tty in pane)) next   # this Claude is not running inside tmux
@@ -54,8 +61,24 @@
     path = $5
     if (index(path, home) == 1) path = "~" substr(path, length(home) + 1)
 
-    printf "%s\t%s\t%s\t%s\t%s\t%5s\t%s\t%s\n",
-      rank, pane[tty], $2, kind, icon, age, loc[tty], path
+    # A name you set with /rename shows plain, so it stands out; one Claude
+    # picked for itself is dimmed, because a derived name is usually just a
+    # restatement of the path already in the last column. Sessions from older
+    # Claude versions report no source and are dimmed with the rest.
+    label = ($2 in name) ? name[$2] : "-"
+    # Fitted to a constant width *before* the escapes go on, so colour never
+    # counts toward the field width and this column adds no raggedness to `path`
+    # beyond the variable-width `loc` already ahead of it. ASCII ".." rather than
+    # an ellipsis keeps the count right where length() measures bytes.
+    # @claude_name_width 0 leaves the column its natural width.
+    if (namew > 2) {
+      if (length(label) > namew) label = substr(label, 1, namew - 2) ".."
+      label = sprintf("%-" namew "s", label)
+    }
+    if (name_src[$2] != "user") label = "\033[90m" label "\033[0m"
+
+    printf "%s\t%s\t%s\t%s\t%s\t%5s\t%s\t%s\t%s\n",
+      rank, pane[tty], $2, kind, icon, age, loc[tty], label, path
   }
 ' | sort -t$'\t' -k1,1n -k6,6n
 # rank asc (what needs you floats up), then age asc so whatever just went idle
